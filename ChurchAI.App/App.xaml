<Application x:Class="ChurchAI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChurchAI.App"
             Exit="OnExit"
             xmlns:viewmodels="clr-namespace:ChurchAI.App.ViewModels"
             xmlns:converters="clr-namespace:ChurchAI.App.Converters"
             xmlns:views="clr-namespace:ChurchAI.App.Views"
             xmlns:helpers="clr-namespace:ChurchAI.App.Helpers">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <!-- Global TextBox Style for White Caret and Auto-Highlighting on Click/Focus -->
        <Style TargetType="TextBox">
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#3B82F6"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Setter Property="helpers:TextBoxSelectAllBehavior.AutoSelectAllOnFocus" Value="True"/>
        </Style>

        <DataTemplate DataType="{x:Type viewmodels:BibleSearchViewModel}">
            <views:BibleSearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProjectionViewModel}">
            <views:ProjectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HymnSearchViewModel}">
            <views:HymnSearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CommunityViewModel}">
            <views:CommunityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MediaViewModel}">
            <views:MediaView />
        </DataTemplate>

        <!-- Toggle Switch Style (Custom CheckBox template) -->
        <Style x:Key="LiquidToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid x:Name="Track" Width="42" Height="20" Margin="0,0,10,0">
                                <Border x:Name="BackgroundBorder" Background="#131625" BorderBrush="#2D325A" BorderThickness="1.5" CornerRadius="10"/>
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#94A3B8" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#0A334B"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#00E5FF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
