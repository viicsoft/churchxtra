<Window x:Class="ChurchAI.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChurchAI - Login" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Deactivated="Window_Deactivated"
        SizeToContent="WidthAndHeight">
    <Grid>
        <!-- Center Card Container -->
        <Border Width="450" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20">
            <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/splash_bg.png" Stretch="UniformToFill" />
            </Border.Background>
            <Grid>
                <!-- Overlay to slightly darken background if needed -->
                <Border Background="#33000000" CornerRadius="20" />

        <!-- Initial Login Button -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInitialButtonVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLoginFormVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            
            <Button Command="{Binding ShowLoginFormCommand}" Width="200" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#A07855" CornerRadius="25">
                            <TextBlock Text="Login" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Login Form -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoginFormVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1" BeginTime="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                <!-- Logo -->
                <Border Width="80" Height="80" CornerRadius="40" BorderBrush="White" BorderThickness="3" Margin="0,0,0,30">
                    <TextBlock Text="D" FontSize="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                </Border>
                
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="Invalid username or password.">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="Username and password are required.">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Username -->
                <Border Background="#33FFFFFF" CornerRadius="20" Height="50" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="👤" Foreground="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" VerticalContentAlignment="Center" 
                                 Padding="0,0,15,0" />
                    </Grid>
                </Border>

                <!-- Password -->
                <Border Background="#33FFFFFF" CornerRadius="20" Height="50" Margin="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔒" Foreground="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        <PasswordBox x:Name="pwdBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" VerticalContentAlignment="Center" Padding="0,0,15,0" />
                    </Grid>
                </Border>

                <!-- Submit Button -->
                <Button Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=pwdBox}" Height="50" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#A07855" CornerRadius="25">
                                <TextBlock Text="Log In" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Lost Password -->
                <TextBlock Text="Lost your password?" Foreground="#BBBBBB" HorizontalAlignment="Center" Margin="0,20,0,0" Cursor="Hand" FontSize="12"/>
            </StackPanel>
        </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
