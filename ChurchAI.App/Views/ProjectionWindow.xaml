<Window x:Class="ChurchAI.App.Views.ProjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Projection" Height="450" Width="800"
        WindowStyle="None" Topmost="True"
        Background="Black" Foreground="White" ShowInTaskbar="False"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    
    <Grid x:Name="MainGrid">
        <Border x:Name="BackgroundBorder" Background="Black" />
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed" />
        <MediaElement x:Name="BackgroundVideo" LoadedBehavior="Play" UnloadedBehavior="Manual" MediaEnded="BackgroundVideo_MediaEnded" Stretch="UniformToFill" Visibility="Collapsed" Volume="0" IsMuted="True" />
        <wv2:WebView2 x:Name="YouTubeWebPlayer" Visibility="Collapsed" />
        <Border x:Name="BackgroundTintOverlay" Background="Black" Opacity="0.35" Visibility="Collapsed" />
        
        <!-- Logo Display -->
        <Viewbox x:Name="LogoViewbox" Stretch="Uniform" Margin="100" Visibility="Collapsed">
            <Image Source="/Assets/app_logo.png" MaxWidth="600" MaxHeight="600" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Viewbox>

        <!-- Content Display -->
        <Grid x:Name="ContentBorder" Margin="40,30,40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ContentTextGrid" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <StackPanel x:Name="ContentStackPanel" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="VerseText" Text="Verse Text" Foreground="White" FontSize="88" FontWeight="Bold" FontFamily="Segoe UI" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ReferenceText" Grid.Row="1" Text="Reference" Foreground="White" FontSize="40" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,15,0,10"/>
        </Grid>

        <!-- Lower Third Graphic Overlay Host Container -->
        <Grid x:Name="LowerThirdOverlayHost" Margin="60" Visibility="Collapsed" Panel.ZIndex="50">
            <!-- Position Container: BottomLeft / BottomCenter / BottomRight / TopLeft -->
            <Grid x:Name="LowerThirdPositionContainer" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeAll" PreviewMouseLeftButtonDown="LowerThird_MouseDown" PreviewMouseMove="LowerThird_MouseMove" PreviewMouseLeftButtonUp="LowerThird_MouseUp">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LtScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform x:Name="LtTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- 1. Style: Blue Angular Parallelogram -->
                <Grid x:Name="LtStyleBlueAngular" Visibility="Collapsed">
                    <StackPanel Orientation="Vertical">
                        <Grid Margin="0,0,0,-4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Slanted Accent Tag -->
                            <Border x:Name="LtBlueTagBorder" Grid.Column="0" Background="#0038A8" Padding="20,8,25,8" Margin="0,0,-15,0" Canvas.ZIndex="2">
                                <Border.LayoutTransform>
                                    <SkewTransform AngleX="-25"/>
                                </Border.LayoutTransform>
                                <TextBlock x:Name="LtBlueTag" Text="SPEAKER" Foreground="White" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI">
                                    <TextBlock.LayoutTransform>
                                        <SkewTransform AngleX="25"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Border>
                            <!-- Main Silver Headline Banner -->
                            <Border x:Name="LtBlueTitleBorder" Grid.Column="1" Background="#F1F5F9" Padding="45,10,35,10" Canvas.ZIndex="1">
                                <Border.LayoutTransform>
                                    <SkewTransform AngleX="-25"/>
                                </Border.LayoutTransform>
                                <TextBlock x:Name="LtBlueTitle" Text="Headline Text Here" Foreground="#0F172A" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI">
                                    <TextBlock.LayoutTransform>
                                        <SkewTransform AngleX="25"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Border>
                        </Grid>
                        <!-- Subtitle Dark Blue Strip -->
                        <Border x:Name="LtBlueSubBorder" Background="#0284C7" Padding="35,6,25,6" HorizontalAlignment="Right" Margin="0,0,30,0">
                            <Border.LayoutTransform>
                                <SkewTransform AngleX="-25"/>
                            </Border.LayoutTransform>
                            <TextBlock x:Name="LtBlueSubtitle" Text="Subtext Space Here" Foreground="White" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI">
                                <TextBlock.LayoutTransform>
                                    <SkewTransform AngleX="25"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. Style: Gold Badge & Charcoal Banner -->
                <Grid x:Name="LtStyleGoldBadge" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Circle Gold Badge -->
                        <Grid Margin="0,0,-20,0" Canvas.ZIndex="3" VerticalAlignment="Center">
                            <Ellipse Width="90" Height="90" Stroke="#1E293B" StrokeThickness="3">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#D97706" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="LtGoldTag" Text="KEYNOTE" Foreground="#0F172A" FontSize="14" FontWeight="ExtraBold" TextWrapping="Wrap" TextAlignment="Center" Width="70" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <!-- Dark Charcoal Slanted Strip -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Border Background="#1E293B" Padding="40,12,30,12" CornerRadius="0,6,6,0">
                                <Border.LayoutTransform>
                                    <SkewTransform AngleX="-20"/>
                                </Border.LayoutTransform>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel.LayoutTransform>
                                        <SkewTransform AngleX="20"/>
                                    </StackPanel.LayoutTransform>
                                    <TextBlock x:Name="LtGoldTitle" Text="Speaker Name Here" Foreground="White" FontSize="30" FontWeight="Bold"/>
                                    <TextBlock x:Name="LtGoldSubtitle" Text="Special Guest Minister" Foreground="#F59E0B" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 3. Style: Cyberpunk Purple Chevron -->
                <Grid x:Name="LtStyleCyberpunkPurple" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <!-- Logo Badge -->
                        <Border Width="85" Height="85" CornerRadius="42.5" BorderBrush="#00E5FF" BorderThickness="3" Margin="0,0,-15,0" Canvas.ZIndex="3" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4C1D95" Offset="0"/>
                                    <GradientStop Color="#1E1B4B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="ChurchXtra" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Border Padding="35,10,30,10" CornerRadius="0,10,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#5B21B6" Offset="0"/>
                                        <GradientStop Color="#1E1B4B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❯❯ " Foreground="#00E5FF" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock x:Name="LtPurpleTitle" Text="Headline Text Here" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="LtPurpleSubBorder" Background="#0284C7" Padding="35,5,25,5" CornerRadius="0,0,10,0">
                                <TextBlock x:Name="LtPurpleSubtitle" Text="Subtext details here" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 4. Style: Classic Navy Slate -->
                <Grid x:Name="LtStyleClassicNavy" Visibility="Collapsed">
                    <Border Background="#E60F172A" BorderBrush="#00E5FF" BorderThickness="4,0,0,0" CornerRadius="0,8,8,0" Padding="25,12,35,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LtNavyTag" Text="ANNOUNCEMENT" Foreground="#00E5FF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="LtNavyTitle" Text="Main Speaker Title" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,3,0,0"/>
                            <TextBlock x:Name="LtNavySubtitle" Text="Subtext Information" Foreground="#94A3B8" FontSize="16" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- Scripture Lower Third Mode Host Container (5 Broadcast Templates) -->
        <Grid x:Name="ScriptureLowerThirdHost" Margin="60" Visibility="Collapsed" Panel.ZIndex="60">
            <Grid x:Name="ScriptureLtPositionContainer" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="SizeAll" PreviewMouseLeftButtonDown="LowerThird_MouseDown" PreviewMouseMove="LowerThird_MouseMove" PreviewMouseLeftButtonUp="LowerThird_MouseUp">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ScriptureLtScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform x:Name="ScriptureLtTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Template 1: Pill Capsule Sand (Cream capsule + dark condensed text + floating gold reference badge) -->
                <Grid x:Name="TplPillCapsuleSand" Visibility="Collapsed" Margin="0,0,0,20">
                    <Grid>
                        <!-- Main Cream/Sand Pill Box -->
                        <Border Background="#E5E3D8" CornerRadius="45" Padding="55,24,55,28" MaxWidth="1500" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.35"/>
                            </Border.Effect>
                            <TextBlock x:Name="TplSandVerseText" Text="“Rabbi, look! The fig tree you cursed has withered!” “Have faith in God,” Jesus answered."
                                       Foreground="#1C1C1C" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI, sans-serif"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Floating Gold Reference Badge (Bottom Right Accent) -->
                        <Border Background="#F59E0B" CornerRadius="10" Padding="18,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,50,-15" Canvas.ZIndex="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock x:Name="TplSandRefText" Text="MARK 11:12-22" Foreground="#0F172A" FontSize="20" FontWeight="ExtraBold" FontFamily="Segoe UI, sans-serif"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Template 2: Dual Stacked Coral & Off-White (Dusty Rose Category Banner + Off-White Verse Box) -->
                <Grid x:Name="TplDualStackedCoral" Visibility="Collapsed" Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- Top Category/Reference Dusty Rose Banner -->
                        <Border Background="#D49A9A" Padding="35,8,35,8" CornerRadius="6,6,0,0" HorizontalAlignment="Left" Margin="0,0,0,-2" Canvas.ZIndex="5">
                            <TextBlock x:Name="TplCoralRefText" Text="SCRIPTURE READING • MALACHI 3:3" Foreground="#1E1B4B" FontSize="18" FontWeight="ExtraBold" FontFamily="Segoe UI, sans-serif"/>
                        </Border>

                        <!-- Main Off-White Verse Box -->
                        <Border Background="#E8E8DF" Padding="45,22,45,22" CornerRadius="0,12,12,12" MaxWidth="1550">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="5" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock x:Name="TplCoralVerseText" Text="GIVE ONLINE AT VOUSCHURCH.COM/VISION" Foreground="#1E1B4B" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI, sans-serif" TextWrapping="Wrap" TextAlignment="Left"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Template 3: Dual Mint Glassmorphism (Floating Mint Reference Capsule + Translucent Mint Verse Card) -->
                <Grid x:Name="TplDualMintGlass" Visibility="Collapsed" Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- Floating Mint Reference Capsule -->
                        <Border Background="#A7F3D0" CornerRadius="20" Padding="30,8" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.25"/>
                            </Border.Effect>
                            <TextBlock x:Name="TplMintRefText" Text="LUKE 4:18-19" Foreground="#065F46" FontSize="22" FontWeight="ExtraBold" FontFamily="Segoe UI, sans-serif"/>
                        </Border>

                        <!-- Translucent Mint Verse Card -->
                        <Border Background="#D95EEAD4" CornerRadius="24" Padding="50,22,50,22" MaxWidth="1500" BorderBrush="#99F6E4" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.35"/>
                            </Border.Effect>
                            <TextBlock x:Name="TplMintVerseText" Text="“THE SPIRIT OF THE LORD IS ON ME, BECAUSE HE HAS ANOINTED ME TO PREACH GOOD NEWS TO THE POOR.”" Foreground="#044E36" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI, sans-serif" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Template 4: Pastel Sage & Rose Pill (Dual Connected Pill: Coral Reference Badge on Left + Sage Green Verse Box on Right) -->
                <Grid x:Name="TplPastelSageRose" Visibility="Collapsed" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Left Coral Reference Badge -->
                        <Border Background="#D9827C" CornerRadius="32,0,0,32" Padding="35,22" Width="280" VerticalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border BorderBrush="#1F2937" BorderThickness="2" CornerRadius="20" Padding="12,6">
                                    <TextBlock x:Name="TplSageRefText" Text="Ephesians&#10;5:22-33" Foreground="#1F2937" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI, sans-serif" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right Sage Green Verse Box -->
                        <Border Background="#A3BCB0" CornerRadius="0,32,32,0" Padding="45,22" MaxWidth="1250" VerticalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock x:Name="TplSageVerseText" Text="and the two will become one flesh.” This is a profound mystery—but I am talking about Christ and the church." Foreground="#111827" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI, sans-serif" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Template 5: Crimson VOUS Broadcast (Black/Crimson Reference Banner + Crisp Off-White Uppercase Box + V Watermark) -->
                <Grid x:Name="TplCrimsonVous" Visibility="Collapsed" Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- Top Crimson/Black Reference Tag -->
                        <Border Background="#000000" Padding="30,7" CornerRadius="4,4,0,0" HorizontalAlignment="Left" Margin="0,0,0,-1" Canvas.ZIndex="5">
                            <TextBlock x:Name="TplCrimsonRefText" Text="MARK 8:22-26" Foreground="#EF4444" FontSize="20" FontWeight="ExtraBold" FontFamily="Segoe UI, sans-serif"/>
                        </Border>

                        <!-- Main Off-White Uppercase Verse Box with V Accent -->
                        <Border Background="#F3F3F0" Padding="45,22,60,22" CornerRadius="0,8,8,8" MaxWidth="1550">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="5" Opacity="0.4"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" x:Name="TplCrimsonVerseText" Text="THEN HIS EYES WERE OPENED, HIS SIGHT WAS RESTORED, AND HE SAW EVERYTHING CLEARLY." Foreground="#0F172A" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI, sans-serif" TextWrapping="Wrap" TextAlignment="Left"/>

                                <!-- Right Winged V Logo Accent -->
                                <TextBlock Grid.Column="1" Text="❖" Foreground="#DC2626" FontSize="44" FontWeight="Bold" VerticalAlignment="Bottom" Margin="25,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Custom Vector Lower Third Host Container -->
        <Grid x:Name="CustomLowerThirdHost" Margin="0" Visibility="Collapsed" Panel.ZIndex="70">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="CustomLtCanvas" Width="1920" Height="1080"/>
            </Viewbox>
        </Grid>

        <!-- Lower Third Resizing Controls Overlay -->
        <Border x:Name="LocalControlsOverlay" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="25" Padding="14,10" Background="#DC0F172A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="20" Panel.ZIndex="100" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Lower Third Independent Resizing Controls -->
                <StackPanel x:Name="LtScalePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="10,0,0,0">
                    <TextBlock Text="↔ W:" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <Slider x:Name="LtScaleXSlider" Minimum="0.4" Maximum="2.5" Value="1.0" Width="65" VerticalAlignment="Center" ValueChanged="LtScaleXSlider_ValueChanged" ToolTip="Adjust Lower Third Width (Scale X)"/>

                    <TextBlock Text="↕ H:" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,3,0"/>
                    <Slider x:Name="LtScaleYSlider" Minimum="0.4" Maximum="2.5" Value="1.0" Width="65" VerticalAlignment="Center" ValueChanged="LtScaleYSlider_ValueChanged" ToolTip="Adjust Lower Third Height (Scale Y)"/>

                    <CheckBox x:Name="LtLockAspectCheck" IsChecked="True" Click="LtLockAspectCheck_Click" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Lock aspect ratio (Scale X and Y together)">
                        <TextBlock Text="🔒 Lock" Foreground="#E2E8F0" FontSize="10"/>
                    </CheckBox>
                </StackPanel>

                <!-- Set Position Button for Dragged Lower Third -->
                <Button x:Name="CommitLtPosBtn" Content="✓ Set Position" Click="CommitLtPosBtn_Click" Background="#10B981" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Padding="10,4" Margin="10,0,0,0" Visibility="Collapsed" Cursor="Hand" ToolTip="Commit dragged lower third position &amp; size live to broadcast &amp; secondary screen">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
