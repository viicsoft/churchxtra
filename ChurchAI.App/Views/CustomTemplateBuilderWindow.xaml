<Window x:Class="ChurchAI.App.Views.CustomTemplateBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vector Lower Third Studio - Custom Template Builder" 
        Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Left Toolbar, Center Canvas, Right Inspector -->
            <RowDefinition Height="*"/>
            <!-- Status / Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="🎨 Vector Lower Third Studio" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <Border Background="#1E293B" CornerRadius="8" Padding="10,4" Margin="15,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Category: " Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <ComboBox SelectedItem="{Binding Category}" Width="140" Background="#0F172A" Foreground="#00E5FF" BorderBrush="#3B82F6">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#1A1D2B"/>
                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                </Style>
                            </ComboBox.Resources>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:entities="clr-namespace:ChurchAI.Core.Entities;assembly=ChurchAI.Core">Speaker</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:entities="clr-namespace:ChurchAI.Core.Entities;assembly=ChurchAI.Core">Scripture</System:String>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Template Name: " Foreground="#94A3B8" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#3B82F6" Padding="8,4" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding ImportFromImageCommand}" Content="📷 AI Import Image" Background="#8B5CF6" Foreground="White" FontWeight="Bold" Padding="14,8" Margin="0,0,10,0" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>

                <Button Command="{Binding SaveTemplateCommand}" Content="💾 Save Template" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="16,8" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Tools Palette -->
                <ColumnDefinition Width="220"/>
                <!-- Center Stage Canvas Viewport -->
                <ColumnDefinition Width="*"/>
                <!-- Right Property Inspector -->
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left Tools Palette -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="12" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="🛠️ SHAPE TOOLS" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                        
                        <Button Command="{Binding AddRectangleCommand}" Content="🟩 Rounded Box" Background="#334155" Foreground="White" Padding="10,8" Margin="0,0,0,8" HorizontalContentAlignment="Left" BorderThickness="0"/>
                        <Button Command="{Binding AddPillCapsuleCommand}" Content="💊 Pill Capsule Badge" Background="#334155" Foreground="White" Padding="10,8" Margin="0,0,0,8" HorizontalContentAlignment="Left" BorderThickness="0"/>
                        <Button Command="{Binding AddParallelogramCommand}" Content="📐 Slanted Banner" Background="#334155" Foreground="White" Padding="10,8" Margin="0,0,0,8" HorizontalContentAlignment="Left" BorderThickness="0"/>
                        <Button Command="{Binding AddEllipseCommand}" Content="⚪ Circle Accent" Background="#334155" Foreground="White" Padding="10,8" Margin="0,0,0,15" HorizontalContentAlignment="Left" BorderThickness="0"/>

                        <TextBlock Text="🔤 TEXT ELEMENTS" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,10,0,10"/>
                        <Button Command="{Binding AddTextPlaceholderCommand}" Content="📝 Add Text Placeholder" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10,8" Margin="0,0,0,15" HorizontalContentAlignment="Left" BorderThickness="0"/>

                        <TextBlock Text="📑 LAYERS" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,10,0,10"/>
                        <ListBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape}" DisplayMemberPath="Name" Background="#0F172A" Foreground="#F8FAFC" Height="140" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding TextPlaceholders}" SelectedItem="{Binding SelectedTextPlaceholder}" DisplayMemberPath="Name" Background="#0F172A" Foreground="#F8FAFC" Height="100" Margin="0,0,0,10"/>

                        <Button Command="{Binding RemoveSelectedLayerCommand}" Content="🗑️ Remove Selected Layer" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="8" BorderThickness="0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Stage Canvas Viewport -->
            <Border Grid.Column="1" Background="#020617" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="2" Padding="10" ClipToBounds="True">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <!-- 1920x1080 Interactive Stage Canvas -->
                        <Border Width="1920" Height="1080" Background="#111827">
                            <Canvas x:Name="BuilderCanvas" Width="1920" Height="1080">
                                <!-- Background Camera Grid Representation -->
                                <TextBlock Text="1080p Broadcast Preview Stage (1920 x 1080)" Foreground="#334155" FontSize="40" FontWeight="Bold" Canvas.Left="50" Canvas.Top="50"/>

                                <!-- Dynamic Shape Layers rendered in code-behind -->
                                <!-- Dynamic Text Layers rendered in code-behind -->
                            </Canvas>
                        </Border>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Right Property Inspector -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="12" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="🎛️ LAYER PROPERTIES" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,0,15"/>

                        <!-- Shape Properties -->
                        <StackPanel Visibility="{Binding SelectedShape, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}">
                            <TextBlock Text="SELECTED SHAPE:" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding SelectedShape.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Margin="0,0,0,10" Padding="6"/>

                            <TextBlock Text="Fill Color (HEX):" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding SelectedShape.FillHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Margin="0,0,0,8" Padding="6"/>

                            <TextBlock Text="Stroke Color (HEX):" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding SelectedShape.StrokeHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Margin="0,0,0,8" Padding="6"/>

                            <TextBlock Text="Corner Radius:" Foreground="#94A3B8"/>
                            <Slider Value="{Binding SelectedShape.CornerRadius, Mode=TwoWay}" Minimum="0" Maximum="100" Margin="0,0,0,8"/>

                            <TextBlock Text="Skew Angle (Slant):" Foreground="#94A3B8"/>
                            <Slider Value="{Binding SelectedShape.SkewX, Mode=TwoWay}" Minimum="-60" Maximum="60" Margin="0,0,0,8"/>

                            <TextBlock Text="Opacity:" Foreground="#94A3B8"/>
                            <Slider Value="{Binding SelectedShape.Opacity, Mode=TwoWay}" Minimum="0.1" Maximum="1.0" Margin="0,0,0,8"/>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Width:" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding SelectedShape.Width, Mode=TwoWay}" Background="#0F172A" Foreground="White" Padding="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Height:" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding SelectedShape.Height, Mode=TwoWay}" Background="#0F172A" Foreground="White" Padding="6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Text Properties -->
                        <StackPanel Visibility="{Binding SelectedTextPlaceholder, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" Margin="0,15,0,0">
                            <TextBlock Text="SELECTED TEXT ELEMENT:" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding SelectedTextPlaceholder.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Margin="0,0,0,10" Padding="6"/>

                            <TextBlock Text="Binding Field:" Foreground="#94A3B8"/>
                            <ComboBox SelectedItem="{Binding SelectedTextPlaceholder.BindingField}" Background="#0F172A" Foreground="#00E5FF" Margin="0,0,0,8">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#1A1D2B"/><Setter Property="Foreground" Value="#F8FAFC"/></Style>
                                </ComboBox.Resources>
                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Title</System:String>
                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Subtitle</System:String>
                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">TagText</System:String>
                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Reference</System:String>
                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">VerseText</System:String>
                            </ComboBox>

                            <TextBlock Text="Font Family:" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding SelectedTextPlaceholder.FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Margin="0,0,0,8" Padding="6" ToolTip="e.g. Segoe UI, Roboto, Montserrat, Georgia, Arial"/>

                            <TextBlock Text="Text Color (HEX):" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding SelectedTextPlaceholder.ForegroundHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Margin="0,0,0,8" Padding="6"/>

                            <TextBlock Text="Font Size:" Foreground="#94A3B8"/>
                            <Slider Value="{Binding SelectedTextPlaceholder.FontSize, Mode=TwoWay}" Minimum="12" Maximum="96" Margin="0,0,0,8"/>

                            <TextBlock Text="Font Weight:" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding SelectedTextPlaceholder.FontWeight, Mode=TwoWay}" Background="#0F172A" Foreground="White" Margin="0,0,0,8" Padding="6"/>

                            <TextBlock Text="Text Alignment:" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding SelectedTextPlaceholder.TextAlignment, Mode=TwoWay}" Background="#0F172A" Foreground="White" Margin="0,0,0,8" Padding="6" ToolTip="Left, Center, or Right"/>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="X Position:" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding SelectedTextPlaceholder.X, Mode=TwoWay}" Background="#0F172A" Foreground="White" Padding="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Y Position:" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding SelectedTextPlaceholder.Y, Mode=TwoWay}" Background="#0F172A" Foreground="White" Padding="6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
        </Border>
    </Grid>
</Window>
