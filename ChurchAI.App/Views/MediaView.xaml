<UserControl x:Class="ChurchAI.App.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#0B0D19" Foreground="#E1E2E6">

    <UserControl.Resources>
        <!-- Modern Sub-Tab Header Style -->
        <Style x:Key="SubTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1D2B"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252A3F"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Card Style -->
        <Style x:Key="MediaCardStyle" TargetType="Border">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Background" Value="#131622"/>
            <Setter Property="BorderBrush" Value="#262A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Border Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Status Notification -->
                <RowDefinition Height="*"/>    <!-- Sub-Tabs Control -->
            </Grid.RowDefinitions>

            <!-- Status Notification Banner -->
            <Border Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#34D399" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>

            <!-- 3-SubTab Main Host Container -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSubTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabPanel">
                        <Setter Property="Margin" Value="0,0,0,10"/>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: YouTube Embed -->
                <TabItem Header="🔗 YouTube Embed" Style="{StaticResource SubTabItemStyle}">
                    <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Inline Quick Add Bar -->
                        <RowDefinition Height="*"/>    <!-- YouTube Cards Grid -->
                    </Grid.RowDefinitions>

                    <!-- Quick Add YouTube Video Bar -->
                    <Border Grid.Row="0" Background="#131622" BorderBrush="#262A45" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Embed Link:" Foreground="#00E5FF" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            
                            <TextBox Grid.Column="1" Text="{Binding YouTubeUrlInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0B0C16" Foreground="White" BorderBrush="#262A45" BorderThickness="1" Padding="8,4" FontSize="11" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"
                                     ToolTip="Paste YouTube URL e.g. https://www.youtube.com/watch?v=VIDEO_ID"/>

                            <TextBox Grid.Column="2" Text="{Binding YouTubeTitleInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0B0C16" Foreground="White" BorderBrush="#262A45" BorderThickness="1" Padding="8,4" FontSize="11" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"
                                     ToolTip="Optional Title"/>

                            <Button Grid.Column="3" Content="➕ Add YouTube Video" Command="{Binding AddYouTubeVideoCommand}" 
                                    Background="#8B5CF6" Foreground="White" FontSize="11" FontWeight="Bold" Padding="12,5" Height="26" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- YouTube Video Cards Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding YouTubeItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MediaCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Thumbnail Box -->
                                            <Border Grid.Row="0" Background="#0A0B13" CornerRadius="6" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="5,2" Background="#CC8B5CF6" CornerRadius="4">
                                                        <TextBlock Text="YouTube" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Title & Category -->
                                            <StackPanel Grid.Row="1" Margin="0,6,0,6">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="10" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="▶ Project Live" Command="{Binding DataContext.ProjectLiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#2563EB" Foreground="White" FontSize="10" FontWeight="Bold" Padding="6,4" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                                <Button Grid.Column="1" Content="🗑️" Command="{Binding DataContext.DeleteMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" FontSize="10" Padding="6,4" BorderThickness="0" Cursor="Hand" ToolTip="Delete Video"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: Media Upload -->
            <TabItem Header="📁 Media Upload" Style="{StaticResource SubTabItemStyle}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Upload Action Bar -->
                        <RowDefinition Height="*"/>    <!-- Media Cards Grid -->
                    </Grid.RowDefinitions>

                    <!-- Import Files Action Bar -->
                    <Border Grid.Row="0" Background="#131622" BorderBrush="#262A45" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Import local media files (PNG, JPG, WEBP, MP4, AVI, MOV):" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="➕ Import Media Files" Command="{Binding ImportMediaCommand}" 
                                    Background="#00E5FF" Foreground="#0B1120" FontSize="11" FontWeight="Bold" Padding="14,5" Height="26" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Local Media Cards Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UploadedMediaItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MediaCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Image/Video Preview Box -->
                                            <Border Grid.Row="0" Background="#0A0B13" CornerRadius="6" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding FilePath}" Stretch="UniformToFill"/>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="5,2" Background="#CC0F172A" CornerRadius="4">
                                                        <TextBlock Text="{Binding Type}" Foreground="#38BDF8" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Title & Category -->
                                            <StackPanel Grid.Row="1" Margin="0,6,0,6">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="10" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="🖼️ Bg" Command="{Binding DataContext.SetAsBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#0F766E" Foreground="White" FontSize="9.5" FontWeight="Bold" Padding="4,4" BorderThickness="0" Margin="0,0,3,0" Cursor="Hand" ToolTip="Set as projection text background"/>
                                                <Button Grid.Column="1" Content="▶ Project" Command="{Binding DataContext.ProjectLiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#2563EB" Foreground="White" FontSize="9.5" FontWeight="Bold" Padding="4,4" BorderThickness="0" Margin="0,0,3,0" Cursor="Hand" ToolTip="Project full screen live"/>
                                                <Button Grid.Column="2" Content="🗑️" Command="{Binding DataContext.DeleteMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" FontSize="9.5" Padding="5,4" BorderThickness="0" Cursor="Hand" ToolTip="Delete Item"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: Projection Backgrounds -->
            <TabItem Header="🎨 Projection Backgrounds" Style="{StaticResource SubTabItemStyle}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Solid Color / Quick Controls Bar -->
                        <RowDefinition Height="*"/>    <!-- Background Presets Cards Grid -->
                    </Grid.RowDefinitions>

                    <!-- Background Quick Action Bar -->
                    <Border Grid.Row="0" Background="#131622" BorderBrush="#262A45" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Quick Background Styles &amp; Presets:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="⬛ Solid Black Background" Command="{Binding SetBlackBackgroundCommand}" 
                                    Background="#1E293B" Foreground="#E2E8F0" FontSize="11" FontWeight="Bold" Padding="14,5" Height="26" BorderThickness="1" BorderBrush="#334155" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Background Presets Cards Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BackgroundItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MediaCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Preset Preview Box -->
                                            <Border Grid.Row="0" Background="#0A0B13" CornerRadius="6" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="🎨 Color Preset" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border Background="{Binding FilePath}" Visibility="{Binding Type, ConverterParameter=Color, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <Image Source="{Binding FilePath}" Stretch="UniformToFill"/>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="5,2" Background="#CC0F172A" CornerRadius="4">
                                                        <TextBlock Text="{Binding Category}" Foreground="#00E5FF" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Title & Type -->
                                            <StackPanel Grid.Row="1" Margin="0,6,0,6">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="10" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="🖼️ Set Background" Command="{Binding DataContext.SetAsBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#0F766E" Foreground="White" FontSize="9.5" FontWeight="Bold" Padding="4,4" BorderThickness="0" Margin="0,0,3,0" Cursor="Hand" ToolTip="Set as active projection background"/>
                                                <Button Grid.Column="1" Content="▶ Project Live" Command="{Binding DataContext.ProjectLiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#2563EB" Foreground="White" FontSize="9.5" FontWeight="Bold" Padding="4,4" BorderThickness="0" Cursor="Hand" ToolTip="Project full screen live"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Border>
</UserControl>
