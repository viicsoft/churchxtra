<UserControl x:Class="ChurchAI.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ChurchAI.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:AudioLevelToHeightConverter x:Key="AudioConv1" BaseHeight="3" Multiplier="12"/>
        <converters:AudioLevelToHeightConverter x:Key="AudioConv2" BaseHeight="5" Multiplier="16"/>
        <converters:AudioLevelToHeightConverter x:Key="AudioConv3" BaseHeight="7" Multiplier="20"/>
        <converters:AudioLevelToHeightConverter x:Key="AudioConv4" BaseHeight="4" Multiplier="14"/>

        <!-- Glass TextBox Style -->
        <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0B0C16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#262A45"/>
                            </Border.BorderBrush>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5FF" Offset="0.0"/>
                                            <GradientStop Color="#8B5CF6" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass ComboBox Style -->
        <Style x:Key="GlassComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0B0C16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false" ClickMode="Press" 
                                          Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.BorderBrush>
                                    <SolidColorBrush Color="#262A45"/>
                                </ToggleButton.BorderBrush>
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#151726"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="8,2,24,2" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0A0B13" BorderBrush="#2D325A" BorderThickness="1" CornerRadius="5" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5FF" Offset="0.0"/>
                                            <GradientStop Color="#8B5CF6" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D325A"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0A0B13" Padding="8">
        <!-- Compact Layout Container (No Scrolling Needed) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: AI Backend Configuration (Top Left) -->
            <Border Grid.Row="0" Grid.Column="0" Background="#131622" BorderBrush="#4A4D56" BorderThickness="1.5" CornerRadius="12" Margin="4" Padding="10" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect Color="#4A4D56" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🤖" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="AI Backend Configuration" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Cloud Switch & Provider inline -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding UseCloudServices}" Style="{StaticResource LiquidToggleSwitchStyle}" VerticalAlignment="Center">
                            <TextBlock Text="Use Cloud Services (Whisper/Groq/OpenAI)" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                        </CheckBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding UseCloudServices, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Provider:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox SelectedValue="{Binding SpeechProvider, Mode=TwoWay}" SelectedValuePath="Content" Style="{StaticResource GlassComboBoxStyle}" Width="110" Height="22">
                                <ComboBoxItem Content="Groq/OpenAI"/>
                                <ComboBoxItem Content="Google"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Whisper / Groq Compact 2-Column Fields Grid -->
                    <StackPanel Visibility="{Binding UseCloudServices, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Visibility="{Binding IsWhisperProviderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Cloud Speech API Key" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding CloudApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Intent API Key (Optional)" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding IntentApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Speech API URL" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SpeechApiUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Intent API URL" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding IntentApiUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Speech Model (Whisper)" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SpeechApiModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Intent Model (Llama)" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding IntentApiModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Google Provider Settings -->
                        <StackPanel Visibility="{Binding IsGoogleProviderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Google JSON Credentials Path" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GoogleCredentialsPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}" Margin="0,0,6,0" ToolTip="e.g. C:\Keys\google-key.json"/>
                                <Button Grid.Column="1" Content="Browse..." Click="BrowseGoogleCredentials_Click" Height="25" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#131625"/>
                                            <Setter Property="Foreground" Value="#00E5FF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="10,2"/>
                                            <Setter Property="FontSize" Value="10.5"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="#262A45"/>
                                                            </Border.BorderBrush>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Display & Output Configuration (Top Right) -->
            <Border Grid.Row="0" Grid.Column="1" Background="#131622" BorderBrush="#4A4D56" BorderThickness="1.5" CornerRadius="12" Margin="4" Padding="10" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect Color="#4A4D56" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="📺" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Display &amp; Output Settings" Foreground="#C084FC" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Auto Route & Display Selector Grid -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding AutoRouteSecondaryDisplay}" Style="{StaticResource LiquidToggleSwitchStyle}" VerticalAlignment="Center">
                            <TextBlock Text="Auto-route to Secondary Display" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                        </CheckBox>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDisplays}" 
                                  SelectedValue="{Binding SelectedDisplayDevice}" 
                                  SelectedValuePath="DeviceName" 
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource GlassComboBoxStyle}" Height="22"/>
                    </Grid>

                    <!-- Switches Grid (NDI, Splitting, Web Server) -->
                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <CheckBox IsChecked="{Binding EnableNDIOutput}" Style="{StaticResource LiquidToggleSwitchStyle}" Margin="0,0,4,4">
                            <TextBlock Text="Enable NDI Output" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding EnableAutoSplitting}" Style="{StaticResource LiquidToggleSwitchStyle}" Margin="4,0,0,4" ToolTip="Splits verses over 4 lines / 220 chars into consecutive slides">
                            <TextBlock Text="Auto-Split Long Verses" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding EnableWebServerOutput}" Style="{StaticResource LiquidToggleSwitchStyle}" Margin="0,0,4,0">
                            <TextBlock Text="Web Server (Mobile)" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                        </CheckBox>
                    </UniformGrid>

                    <!-- NDI Source Name Field -->
                    <StackPanel Visibility="{Binding EnableNDIOutput, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,4">
                        <TextBlock Text="NDI Source Name" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NDISourceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Web Server Details -->
                    <StackPanel Visibility="{Binding EnableWebServerOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Local Web Server URL:" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding WebServerUrl, Mode=OneWay}" Foreground="#00FFA3" BorderThickness="1" IsReadOnly="True" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#2D325A" BorderThickness="1" CornerRadius="4" Padding="2" Background="#0B0C16">
                                <Image Source="{Binding QRCodeImage}" Width="45" Height="45" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Hymnbook Management (Bottom Left) -->
            <Border Grid.Row="1" Grid.Column="0" Background="#131622" BorderBrush="#4A4D56" BorderThickness="1.5" CornerRadius="12" Margin="4" Padding="10" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect Color="#4A4D56" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🎵" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Hymnbook Management" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Active Hymnbook & Custom Name Grid -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Active Hymnbook" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding AvailableHymnbooks}" 
                                      SelectedItem="{Binding SelectedHymnbook}"
                                      Style="{StaticResource GlassComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Custom Hymnbook Name" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding CustomHymnbookName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource GlassTextBoxStyle}"
                                     ToolTip="Enter custom name for uploaded hymnbook"/>
                        </StackPanel>
                    </Grid>

                    <!-- Upload Command Button -->
                    <Button Command="{Binding UploadHymnbookCommand}" Content="Upload Custom Hymnbook (PDF, TXT, JSON, CSV)" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" Height="26">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Name="Bd">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5FF" Offset="0.0"/>
                                            <GradientStop Color="#8B5CF6" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Upload Status Text -->
                    <TextBlock Text="{Binding HymnUploadStatus}" Foreground="#FFC107" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Voice Control & AI Vision (Bottom Right) -->
            <Border Grid.Row="1" Grid.Column="1" Background="#131622" BorderBrush="#4A4D56" BorderThickness="1.5" CornerRadius="12" Margin="4" Padding="10" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect Color="#4A4D56" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🎙️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Voice Control &amp; AI Vision" Foreground="#D946EF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Microphone Switch & Waveform Row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsListening, Mode=OneWay}" Command="{Binding ToggleListeningCommand}" Style="{StaticResource LiquidToggleSwitchStyle}" VerticalAlignment="Center">
                            <TextBlock Text="Microphone Listening" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                        </CheckBox>
                        
                        <!-- Speech Status & Waveform -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Visualizer Waveform -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding IsListening, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Width="2.5" Height="{Binding CurrentAudioLevel, Converter={StaticResource AudioConv1}}" Background="#00E5FF" CornerRadius="1" Margin="1.5,0"/>
                                <Border Width="2.5" Height="{Binding CurrentAudioLevel, Converter={StaticResource AudioConv2}}" Background="#00BCFF" CornerRadius="1" Margin="1.5,0"/>
                                <Border Width="2.5" Height="{Binding CurrentAudioLevel, Converter={StaticResource AudioConv3}}" Background="#8B5CF6" CornerRadius="1" Margin="1.5,0"/>
                                <Border Width="2.5" Height="{Binding CurrentAudioLevel, Converter={StaticResource AudioConv4}}" Background="#D946EF" CornerRadius="1" Margin="1.5,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SpeechStatus}" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Gemini AI Vision Key & Test Button -->
                    <StackPanel>
                        <TextBlock Text="Gemini AI Vision API Key (Screenshot Template Extractor)" Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding GeminiVisionApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}" Margin="0,0,6,0" ToolTip="Enter Gemini API key from Google AI Studio"/>
                            <Button Grid.Column="1" Content="🧪 Test" Command="{Binding TestGeminiVisionKeyCommand}" Background="#8B5CF6" Foreground="White" FontWeight="Bold" FontSize="10.5" Padding="10,2" Height="25" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding GeminiTestStatus}" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
